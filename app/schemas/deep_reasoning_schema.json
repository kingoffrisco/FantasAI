{
  "table_name": "main.fantasai.deep_reasoning",
  "layer": "Analysis",
  "description": "Qwen3 30B deep reasoning outputs for the highest-priority fantasy players. This is a separate reasoning lane on top of the 8B/14B jobs.",
  "version": "1.0",
  "last_updated": "2026-08-17",
  "refresh_schedule": "Weekly or on-demand",
  "record_count": 0,
  "source_tables": [
    "main.fantasai.analysis.player_scores",
    "main.fantasai.analysis.breakout_candidates",
    "main.fantasai.news.player_notes"
  ],
  "r2_location": "analysis/deep_reasoning.json",
  "columns": [
    {
      "name": "player_name",
      "type": "string",
      "description": "Player full name",
      "nullable": false,
      "example": "Brian Thomas Jr."
    },
    {
      "name": "position",
      "type": "string",
      "description": "Fantasy position",
      "nullable": false,
      "allowed_values": ["QB", "RB", "WR", "TE", "DST"]
    },
    {
      "name": "team",
      "type": "string",
      "description": "NFL team abbreviation",
      "nullable": true,
      "example": "JAX"
    },
    {
      "name": "priority",
      "type": "double",
      "description": "Routing priority used to select the player for 30B reasoning",
      "nullable": false
    },
    {
      "name": "input_hash",
      "type": "string",
      "description": "Stable hash of the evidence packet used for caching",
      "nullable": false
    },
    {
      "name": "breakout_score",
      "type": "integer",
      "description": "30B-generated breakout / fantasy upside score (0-100)",
      "nullable": false
    },
    {
      "name": "confidence",
      "type": "integer",
      "description": "Confidence in the reasoning output (0-100)",
      "nullable": false
    },
    {
      "name": "primary_reason",
      "type": "string",
      "description": "Main evidence supporting the recommendation",
      "nullable": false
    },
    {
      "name": "risk_flag",
      "type": "string",
      "description": "Primary downside or caution flag",
      "nullable": false
    },
    {
      "name": "recommendation",
      "type": "string",
      "description": "BUY, HOLD, or AVOID",
      "nullable": false,
      "allowed_values": ["BUY", "HOLD", "AVOID"]
    }
  ],
  "ui_integration": {
    "sorting": "breakout_score DESC",
    "display": "Show as a separate deep-reasoning panel or overlay on player cards",
    "notes": [
      "Designed for complex, multi-factor analysis only",
      "Should remain separate from the 8B extraction pipeline and 14B everyday analysis jobs"
    ]
  }
}
+  function moveFeature(idx, dir) {
+    onChange(prev => {
+      const arr = [...(prev[pos] || [])];
+      const j = idx + dir;
+      if (j < 0 || j >= arr.length) return prev;
+      [arr[idx], arr[j]] = [arr[j], arr[idx]];
+      return { ...prev, [pos]: arr };
+    });
+  }
+
+  function setFeatureWeight(idx, val) {
+    onChange(prev => {
+      const arr = [...(prev[pos] || [])];
